# Dependencies and build output
node_modules/
web/dist/
/tenkstack
# The frontend copied into the binary by scripts/build.sh
internal/webdist/dist/*
!internal/webdist/dist/PLACEHOLDER

# Local state that must never be published: the session signing key would let
# anyone forge a login, and the database holds password hashes and API keys.
*.sqlite
*.sqlite-*
*.dump
session.key
*.key
*.crt
*.pem

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
