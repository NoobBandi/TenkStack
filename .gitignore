# Dependencies and build output
node_modules/
web/dist/
server-go/tenkstack
# The frontend copied into the binary by server-go/build.sh
server-go/internal/webdist/dist/*
!server-go/internal/webdist/dist/PLACEHOLDER

# Local state that must never be published: the session signing key would let
# anyone forge a login, and the database holds password hashes and API keys.
*.sqlite
*.sqlite-*
session.key
*.key
*.crt
*.pem

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
